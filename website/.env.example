# PiCloud Web Dashboard Configuration

# Web Server
PORT=3000
HOST=0.0.0.0

# MQTT Broker Settings
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=

# OpenID Connect (OIDC) Authentication
# In production, set OIDC_BASE_URL to your public domain (e.g. https://picloud.casa.ucl.ac.uk)
# The callback URL is automatically constructed as: ${OIDC_BASE_URL}/auth/callback
OIDC_BASE_URL=http://localhost:3000
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional explicit callback override (defaults to ${OIDC_BASE_URL}/auth/callback if empty):
OIDC_CALLBACK_URL=

# OIDC Scopes requested from provider (space-separated: openid profile email)
OIDC_SCOPES=openid profile email

SESSION_SECRET=picloud-secure-session-secret-change-me

# Dev Mode: Allows one-click local admin sign-in for testing control commands
AUTH_DEV_MODE=true
